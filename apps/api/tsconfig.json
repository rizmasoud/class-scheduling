{
  "compilerOptions": {
    "module": "CommonJS",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@class-scheduling/contracts": ["../../packages/contracts/src/index"],
      "@class-scheduling/domain": ["../../packages/domain/src/index"]
    }
  },
  "include": ["src/**/*", "test/**/*", "drizzle.config.ts"]
}
